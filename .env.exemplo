# Modelo do .env da raiz, lido pelo docker compose. Copie para .env e preencha.
# Este arquivo vai para o Git, sem valores. O .env de verdade fica fora.

# Senha do usuário app do PostgreSQL que roda no contêiner.
BANCO_SENHA=

# Chave que assina os tokens JWT da API.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
CHAVE_DO_TOKEN=
